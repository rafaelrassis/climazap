# Neon: DATABASE_URL = conexão com pooler (host "-pooler"); DIRECT_URL = conexão direta (migrations).
# Local: as duas podem ser iguais.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/climazap?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/climazap?schema=public"
AUTH_SECRET=
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # produção: https://fechouclima.com.br
# Fora da Vercel:
# AUTH_TRUST_HOST=true

# Aviso por e-mail ao técnico (Resend). Sem isso, nenhum e-mail é enviado.
# EMAIL_FROM precisa ser de um domínio verificado no Resend, ex.: "FechouClima <avisos@fechouclima.com.br>"
RESEND_API_KEY=
EMAIL_FROM=

# Cron semanal dos lembretes (Vercel envia "Authorization: Bearer $CRON_SECRET"). Gere com: openssl rand -hex 32
CRON_SECRET=
